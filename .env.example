# Copy to .env on the remote host only. Never commit the filled file.
APP_ENV=production
APP_NAME=notion2local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://notion2local:change-me@db:5432/notion2local
DB_AUTO_CREATE=true
RAW_STORAGE_PATH=/data/raw
BLOB_STORAGE_PATH=/data/blobs
NOTION_API_VERSION=2026-03-11
# Supply one of the supported Notion credentials on the remote host.
# Never commit the filled .env or paste this value into chat/Notion.
# The visual admin console stores a rotated token in the persistent runtime file.
NOTION_TOKEN_FILE=/data/config/notion_token
NOTION_TOKEN=
NOTION_WEBHOOK_SECRET=
SETUP_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
SYNC_TIMEZONE=Asia/Shanghai
RECONCILE_TIME=00:05
SYNC_POLL_SECONDS=15

# Put all durable data on a mounted data disk, not Docker's root filesystem.
NOTION2LOCAL_DATA_ROOT=/home/work_space/notion2local-data

# Optional viewer profile. Pin this value before production upgrades.
TRILIUM_IMAGE=triliumnext/notes:latest
TRILIUM_PORT=8081
